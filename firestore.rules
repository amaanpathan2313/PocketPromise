rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Loans collection — users can only access their own loans
    match /loans/{loanId} {
      // Allow read if the user is the lender
      allow read: if request.auth != null
                  && resource.data.lenderId == request.auth.uid;

      // Allow create if authenticated and the lenderId matches
      allow create: if request.auth != null
                    && request.resource.data.lenderId == request.auth.uid;

      // Allow update if the user is the lender (for marking as paid)
      allow update: if request.auth != null
                    && resource.data.lenderId == request.auth.uid;

      // Disallow delete — loans are archived, not deleted
      allow delete: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
